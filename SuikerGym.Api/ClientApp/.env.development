# No REACT_APP_API_URL in development.
# API calls use relative paths (e.g. /api/contact) so they always
# hit whatever port ASP.NET is running on, regardless of IIS Express or Kestrel.

# Fix HMR WebSocket when proxied through IIS Express / ASP.NET dev server.
# WDS_SOCKET_PORT=0 tells the HMR client to use the page's own port instead of
# hardcoding the React dev server port (3000).
WDS_SOCKET_PORT=0
WDS_SOCKET_HOST=localhost
